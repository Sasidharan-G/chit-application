<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing from this app (customer database, PIN hash, cloud credentials) is copied to
     Google Drive backups or to another device by device-to-device transfer. The app's own encrypted-at-rest
     Backup / Restore (Settings) is the supported way to move data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
