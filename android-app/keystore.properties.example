# Copy to keystore.properties (git-ignored) and fill in. Create the keystore once with:
#   keytool -genkeypair -v -keystore jothivel-release.jks -alias jothivel -keyalg RSA -keysize 2048 -validity 10000
# and keep the .jks file and these passwords somewhere safe and backed up: if they are lost, the
# app can never be updated on Google Play under the same signature.
storeFile=../jothivel-release.jks
storePassword=change-me
keyAlias=jothivel
keyPassword=change-me
