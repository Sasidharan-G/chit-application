// Deploy: Firebase Console -> Firestore Database -> Rules -> paste -> Publish
// (or `firebase deploy --only firestore:rules` from android-app/). Editing this file does NOT change
// anything live until one of those steps is done.
//
// IDENTITY MODEL (Spark plan - no Cloud Functions)
//   * Everyone signs in with Firebase Auth email + password. Anonymous sign-in is NOT used any more.
//   * ADMIN  : an Auth user whose UID has a document in `admins/{uid}` (created once, by hand, in the
//              console - no client can write `admins`).
//   * AGENT  : an Auth user whose UID has an ACTIVE document in `agents/{uid}`. Firebase itself checks
//              the PIN (password) and rate-limits guesses; no PIN hash is stored anywhere in Firestore.
//   * Data an agent may touch is stamped with `agentIds` (the UIDs of the active agents assigned to that
//              chit); a rule only lets a UID that is in that list read it. Queries must carry the same
//              `array-contains` filter, which is what lets Firestore prove the query is allowed.
//   * Collections (payments taken by agents) are create-only for agents: an agent can only create a
//              document for a chit assigned to them, in their own name, unsynced, with a server time. Nobody
//              can edit or delete one afterwards; the admin can only flip `syncedToAdmin` (and refresh
//              `agentIds` when assignments change).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveAgent() {
      return signedIn()
        && exists(/databases/$(database)/documents/agents/$(request.auth.uid))
        && get(/databases/$(database)/documents/agents/$(request.auth.uid)).data.isActive == true;
    }

    // An active agent whose UID is stamped on this document.
    function agentMayRead(data) {
      return isActiveAgent() && ('agentIds' in data) && request.auth.uid in data.agentIds;
    }

    function optionalString(data, key) {
      return !(key in data) || data[key] == null || data[key] is string;
    }

    function optionalNumber(data, key) {
      return !(key in data) || data[key] == null || data[key] is number;
    }

    function optionalBool(data, key) {
      return !(key in data) || data[key] == null || data[key] is bool;
    }

    // ---- admins: readable only by that admin (so the app can confirm it is one). No client writes.
    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // ---- adminPins: the admin's app PIN, shared between the admin's phones -----------------------
    // Holds the SALTED HASH of the PIN (never the PIN) and when it was changed, so a new phone can take
    // over the existing PIN and a change on one phone reaches the others. Only that admin can touch it.
    match /adminPins/{uid} {
      function ownsPin() {
        return signedIn() && request.auth.uid == uid && isAdmin();
      }

      allow get: if ownsPin();
      allow list: if false;

      allow create, update: if ownsPin()
        && request.resource.data.keys().hasOnly(['pinHash', 'changedAt'])
        && request.resource.data.keys().hasAll(['pinHash', 'changedAt'])
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.size() >= 20
        && request.resource.data.pinHash.size() <= 200
        && request.resource.data.changedAt is number;

      allow delete: if false;
    }

    // ---- sessions: one live login per account -------------------------------------------------
    // `sessions/{uid}` names the phone that is logged in as that admin / agent and when it last checked in.
    // Only the account itself (an admin, or an active agent) may read, write or delete its own record; the
    // client refuses a second phone while the record is live (see SessionGuard in the app).
    match /sessions/{uid} {
      function ownsSession() {
        return signedIn() && request.auth.uid == uid && (isAdmin() || isActiveAgent());
      }

      allow get: if ownsSession();
      allow list: if false;

      allow create, update: if ownsSession()
        && request.resource.data.keys().hasOnly(['deviceId', 'deviceName', 'lastSeen'])
        && request.resource.data.keys().hasAll(['deviceId', 'lastSeen'])
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0
        && request.resource.data.deviceId.size() <= 64
        && (!('deviceName' in request.resource.data) || (request.resource.data.deviceName is string && request.resource.data.deviceName.size() <= 80))
        && request.resource.data.lastSeen == request.time;

      allow delete: if ownsSession();
    }

    // ---- agents -----------------------------------------------------------------------------
    // Admin manages them; an agent reads only their own document (no PIN hash is stored here).
    match /agents/{agentId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == agentId);
      allow list: if isAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'isActive', 'assignedGroups', 'authEmail', 'gen', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasAll(['name', 'phone', 'isActive', 'assignedGroups'])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.isActive is bool
        && request.resource.data.assignedGroups is list;

      allow delete: if isAdmin();
    }

    // ---- reference data pushed by the admin: readable by admin, or by an agent stamped on it ------
    match /chitGroups/{groupId} {
      allow get, list: if isAdmin() || agentMayRead(resource.data);
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'registerNo', 'chitValue', 'durationMonths', 'subscriberCount', 'branch', 'startDate', 'status', 'agentIds'])
        && request.resource.data.agentIds is list
        && optionalNumber(request.resource.data, 'chitValue')
        && optionalNumber(request.resource.data, 'durationMonths')
        && optionalNumber(request.resource.data, 'subscriberCount')
        && optionalString(request.resource.data, 'status');
    }

    match /members/{memberId} {
      allow get, list: if isAdmin() || agentMayRead(resource.data);
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
             'name', 'phone', 'photoUrl', 'nomineeName', 'nomineePhone', 'role', 'isActive',
             'dob', 'gender', 'addressLine', 'city', 'state', 'pincode', 'panNo',
             'selectedChitId', 'ticketNo', 'installmentAmount', 'joiningDate', 'dueDate',
             'nomineeRelationship', 'agentIds'
           ])
        && request.resource.data.agentIds is list
        && optionalBool(request.resource.data, 'isActive');
    }

    match /chitMemberships/{membershipId} {
      allow get, list: if isAdmin() || agentMayRead(resource.data);
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['memberId', 'groupId', 'ticketNo', 'installmentAmountPaise', 'joiningDate', 'dueDate', 'isActive', 'agentIds'])
        && request.resource.data.agentIds is list
        && optionalString(request.resource.data, 'memberId')
        && optionalString(request.resource.data, 'groupId')
        && optionalNumber(request.resource.data, 'installmentAmountPaise')
        && optionalBool(request.resource.data, 'isActive');
    }

    match /installments/{installmentId} {
      allow get, list: if isAdmin() || agentMayRead(resource.data);
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['groupId', 'installmentNo', 'baseAmount', 'kasaruAmount', 'payoutAmount', 'auctionDate', 'status', 'winningMemberId', 'agentIds'])
        && request.resource.data.agentIds is list
        && optionalString(request.resource.data, 'groupId')
        && optionalNumber(request.resource.data, 'installmentNo')
        && optionalNumber(request.resource.data, 'baseAmount');
    }

    // ---- collections (payments) -------------------------------------------------------------
    match /collections/{collectionId} {
      function shape(d) {
        return d.keys().hasOnly([
                 'agentId', 'agentName', 'memberId', 'memberName', 'groupId', 'chitNo', 'amountPaise',
                 'mode', 'referenceNo', 'receiptNo', 'notes', 'businessDate', 'timestamp', 'status',
                 'syncedToAdmin', 'requestId', 'agentIds'
               ])
            && d.keys().hasAll(['memberId', 'groupId', 'amountPaise', 'mode', 'receiptNo', 'businessDate', 'status', 'syncedToAdmin', 'requestId', 'agentIds'])
            && d.memberId is string
            && d.groupId is string
            && d.amountPaise is int
            && d.amountPaise > 0
            && d.mode is string
            && d.syncedToAdmin is bool
            && d.agentIds is list
            && d.requestId == collectionId
            && (!('timestamp' in d) || d.timestamp == request.time);
      }

      allow get, list: if isAdmin() || agentMayRead(resource.data);

      // The admin may record its own collections (already applied locally, so syncedToAdmin = true).
      allow create: if (isAdmin() && shape(request.resource.data))
        // An agent may only create a payment for a chit assigned to them, under their own UID.
        || (isActiveAgent()
            && shape(request.resource.data)
            && request.resource.data.agentId == request.auth.uid
            && request.resource.data.syncedToAdmin == false
            && request.resource.data.amountPaise <= 100000000
            && request.auth.uid in get(/databases/$(database)/documents/chitGroups/$(request.resource.data.groupId)).data.agentIds
            && request.resource.data.agentIds == get(/databases/$(database)/documents/chitGroups/$(request.resource.data.groupId)).data.agentIds);

      // Immutable afterwards. The only change anyone may make is the admin marking it applied, or
      // refreshing which agents can see it after assignments change.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncedToAdmin', 'agentIds'])
        && request.resource.data.syncedToAdmin is bool
        && request.resource.data.agentIds is list;

      allow delete: if false;
    }
  }
}
